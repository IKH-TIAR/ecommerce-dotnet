# ====================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Commit to Git as documentation)
# Copy this file to .env and replace with your real secrets!
# ====================================================================

# PostgreSQL Configuration
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_PORT=5433

# JWT Configuration (Secret must be at least 32 characters long!)
JWT_SECRET=SuperSecretKeyForEcommerceJwtSigningMustBeAtLeast32Chars123!
JWT_ISSUER=EcommerceApi
JWT_AUDIENCE=EcommerceClient
JWT_EXPIRY_MINUTES=60
